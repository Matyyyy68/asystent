{
  "name": "sentinel-ai-user",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis",
    "lint": "tsc --noEmit && node --check electron/main.cjs && node --check electron/preload.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "pl.sentinelai.user",
    "productName": "Sentinel AI",
    "directories": {
      "output": "../artifacts/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../artifacts/engine",
        "to": "engine"
      },
      {
        "from": "../browser-extension",
        "to": "BrowserExtension"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh",
      "installerLanguages": [
        "pl_PL"
      ],
      "uninstallerIcon": "assets/sentinel.ico",
      "installerIcon": "assets/sentinel.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp"
    },
    "win": {
      "icon": "assets/sentinel.ico",
      "signExecutable": false
    }
  },
  "description": "Lokalna analiza podejrzanych wiadomości i domen na Windows",
  "author": "Sentinel AI contributors"
}
