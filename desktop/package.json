{
  "name": "sentinel-ai-user",
  "version": "0.15.38",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ../scripts/copy-media.mjs desktop && vite --host 127.0.0.1",
    "build": "tsc --noEmit && node ../scripts/copy-media.mjs desktop && vite build",
    "start": "electron .",
    "package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../installer/build-installer.ps1 -Offline",
    "package:allow-downloads": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../installer/build-installer.ps1 -AllowDownloads",
    "lint": "tsc --noEmit && node --check electron/main.cjs && node --check electron/engine-client.cjs && node --check electron/preload.cjs",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "build": {
    "appId": "pl.sentinelai.user",
    "productName": "Sentinel AI",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../artifacts/desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../artifacts/engine",
        "to": "engine"
      },
      {
        "from": "../browser-extension",
        "to": "BrowserExtension"
      },
      {
        "from": "../artifacts/third-party-notices.txt",
        "to": "ThirdPartyNotices/npm-runtime.txt"
      }
    ],
    "win": {
      "icon": "assets/sentinel.ico",
      "signExecutable": false
    }
  },
  "description": "Lokalna analiza podejrzanych wiadomości i domen na Windows",
  "author": "Sentinel AI contributors"
}
