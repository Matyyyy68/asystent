{
  "manifest_version": 3,
  "name": "Sentinel AI — ochrona przeglądania",
  "version": "0.15.17",
  "description": "Lokalnie sprawdza adresy w Edge i Chrome przez Native Messaging.",
  "key": "",
  "permissions": [
    "webNavigation",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stan ochrony Sentinel AI",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "warning.js",
        "style.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
