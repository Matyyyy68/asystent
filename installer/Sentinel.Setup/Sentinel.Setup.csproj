<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Sentinel.AI.Setup</AssemblyName>
    <RootNamespace>Sentinel.Setup</RootNamespace>
    <ApplicationIcon>../../desktop/assets/sentinel.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
    <AssemblyMetadata Include="SentinelPayloadSha256" Value="$(PayloadSha256)" />
    <EmbeddedResource Include="../../media/illustrations/installer/welcome.png" LogicalName="installer-welcome.png" />
    <EmbeddedResource Include="../../media/illustrations/installer/prepare.png" LogicalName="installer-prepare.png" />
    <EmbeddedResource Include="../../media/illustrations/installer/configure.png" LogicalName="installer-configure.png" />
    <EmbeddedResource Include="../../media/illustrations/installer/installing.png" LogicalName="installer-installing.png" />
    <EmbeddedResource Include="../../media/illustrations/installer/complete.png" LogicalName="installer-complete.png" />
    <EmbeddedResource Include="../../media/illustrations/installer/error.png" LogicalName="installer-error.png" />
  </ItemGroup>
</Project>
