<Window x:Class="Sentinel.Desktop.FirstRunWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Witaj w Sentinel AI" Width="620" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterScreen" Background="#F1F5F9" Foreground="#172033">
 <StackPanel Margin="28">
  <TextBlock Text="Witaj w Sentinel AI" FontSize="28" FontWeight="Bold"/>
  <TextBlock Text="Sprawdzaj podejrzane wiadomości i adresy na swoim komputerze." TextWrapping="Wrap" Margin="4,12"/>
  <Border Background="White" Padding="16" Margin="4,8"><StackPanel>
   <TextBlock Text="Gdzie zapisywać ustawienia i historię?" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Zalecany folder jest prywatny dla Twojego konta Windows. Możesz pozostawić go bez zmian." TextWrapping="Wrap"/>
   <TextBlock x:Name="DirectoryLabel" TextWrapping="Wrap" Margin="4,12"/>
   <Button Content="Wybierz inny folder…" Click="ChooseDirectory" HorizontalAlignment="Left"/>
  </StackPanel></Border>
  <TextBlock Text="Analiza okien pozostanie wyłączona, dopóki samodzielnie jej nie włączysz. Wklejoną wiadomość lub adres możesz sprawdzić od razu." TextWrapping="Wrap" Margin="4,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Anuluj" IsCancel="True"/>
   <Button Content="Rozpocznij" IsDefault="True" Click="Continue" FontWeight="SemiBold"/>
  </StackPanel>
 </StackPanel>
</Window>
