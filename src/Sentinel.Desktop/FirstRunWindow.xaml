<Window x:Class="Sentinel.Desktop.FirstRunWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Witaj w Sentinel AI" Width="680" MaxHeight="900" SizeToContent="Height" ResizeMode="CanMinimize"
 WindowStartupLocation="CenterScreen" Background="#F1F5F9" Foreground="#172033">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="Witaj w Sentinel AI" FontSize="28" FontWeight="Bold"/>
  <TextBlock Text="Sprawdzaj podejrzane wiadomości i adresy na swoim komputerze." TextWrapping="Wrap" Margin="4,12"/>
  <Border Background="#EAF1FB" Padding="16" Margin="4,6"><StackPanel>
   <TextBlock x:Name="VariantLabel" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="RecommendationLabel" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <Border Background="White" Padding="16" Margin="4,6"><StackPanel>
   <TextBlock Text="Sprawdzenie komputera" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Wykryte informacje są używane wyłącznie lokalnie. Nie skanujemy dokumentów, poczty ani historii przeglądania." TextWrapping="Wrap" Margin="0,2,0,10"/>
   <TextBlock x:Name="SystemSummary" TextWrapping="Wrap"/>
   <TextBlock x:Name="InstalledProtectionSummary" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock x:Name="ModelSummary" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <Button Content="Przetestuj lokalną analizę" Click="RunSelfTest" HorizontalAlignment="Left" Margin="0,12,0,4"/>
   <TextBlock x:Name="SelfTestStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></Border>
  <Border Background="White" Padding="16" Margin="4,8"><StackPanel>
   <TextBlock Text="Gdzie zapisywać ustawienia i historię?" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Zalecany folder jest prywatny dla Twojego konta Windows. Możesz pozostawić go bez zmian." TextWrapping="Wrap"/>
   <TextBlock x:Name="DirectoryLabel" TextWrapping="Wrap" Margin="4,12"/>
   <Button Content="Wybierz inny folder…" Click="ChooseDirectory" HorizontalAlignment="Left"/>
  </StackPanel></Border>
  <TextBlock Text="Aktywne są lokalne reguły i historia. Analiza okien pozostanie wyłączona, dopóki samodzielnie jej nie włączysz. Wklejoną wiadomość lub adres możesz sprawdzić od razu. Model AI i baza wiedzy nie są dostępne w tej wersji." TextWrapping="Wrap" Margin="4,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Anuluj" IsCancel="True"/>
   <Button Content="Rozpocznij" IsDefault="True" Click="Continue" FontWeight="SemiBold"/>
  </StackPanel>
</StackPanel></ScrollViewer>
</Window>
