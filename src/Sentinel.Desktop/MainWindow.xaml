<Window x:Class="Sentinel.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Sentinel AI" Width="1120" Height="790" MinWidth="760" MinHeight="620"
 Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}">
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="2,0,2,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentOrange}" VerticalAlignment="Center"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Margin="12,0"><TextBlock Text="Sentinel AI" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding ProductVariant}" Style="{StaticResource MutedText}"/></StackPanel>
    <Border Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="{Binding Monitoring.ProtectionStatus}" FontSize="12"/></Border>
   </StackPanel>
   <Button Grid.Column="1" Content="Ustawienia" Command="{Binding OpenSettings}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
  </Grid>
  <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
   <TabItem Header="Start">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,16,6,10">
     <TextBlock Text="Dzień dobry" FontSize="26" FontWeight="SemiBold" Margin="8,4,8,0"/>
     <TextBlock Text="Podsumowanie działania Sentinel AI na tym urządzeniu." Style="{StaticResource MutedText}" Margin="8,0,8,14"/>
     <Border Style="{StaticResource Card}" Padding="22">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Width="50" Height="50" CornerRadius="16" Background="#1A3478F6" VerticalAlignment="Top"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="{Binding Monitoring.ProtectionStatus}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Monitoring.ProtectionDescription}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
       <Button Grid.Column="2" Content="{Binding Monitoring.PauseLabel}" Command="{Binding Monitoring.TogglePause}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="150"/>
      </Grid>
     </Border>
     <UniformGrid Columns="3" Margin="0,10">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="&#xE9D9;  Zdarzenia w historii" FontWeight="SemiBold"/><TextBlock Text="{Binding EventCount}" Style="{StaticResource StatValue}"/><TextBlock Text="Do 500 ostatnich lokalnych wpisów" Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="&#xE7BA;  Wysokie ryzyko" FontWeight="SemiBold"/><TextBlock Text="{Binding ThreatCount}" Style="{StaticResource StatValue}" Foreground="{DynamicResource DangerBrush}"/><TextBlock Text="W widocznej historii" Style="{StaticResource MutedText}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="&#xE823;  Ostatnie ostrzeżenie" FontWeight="SemiBold"/><TextBlock Text="{Binding LastWarning}" FontSize="16" FontWeight="SemiBold" Margin="2,12,2,8"/><TextBlock Text="{Binding VersionText}" Style="{StaticResource MutedText}"/></StackPanel></Border>
     </UniformGrid>
     <Grid Margin="8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ostatnia aktywność" Style="{StaticResource SectionTitle}"/><Button Grid.Column="1" Content="Zobacz wszystkie" Command="{Binding OpenHistory}" Style="{StaticResource SecondaryButton}"/></Grid>
     <Border Style="{StaticResource Card}" Padding="12">
      <StackPanel>
       <ItemsControl ItemsSource="{Binding RecentEvents}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="8,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Category, Converter={StaticResource EnumLabel}}" FontWeight="SemiBold"/><TextBlock Text=" · "/><TextBlock Text="{Binding Application}" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding Timestamp, StringFormat={}{0:g}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxHeight="38"/></StackPanel><Border Grid.Column="2" Background="{DynamicResource ControlSurface}" CornerRadius="8" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding Risk, Converter={StaticResource EnumLabel}}" FontSize="12" FontWeight="SemiBold"/></Border></Grid></Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <TextBlock Text="Nie wykryto ostatnio zagrożeń. Historia pozostaje na tym urządzeniu." Style="{StaticResource MutedText}" Margin="8" Visibility="{Binding RecentEvents.Count, Converter={StaticResource EmptyCountVisibility}}"/>
      </StackPanel>
     </Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Analiza">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Monitoring}" Margin="12">
     <TextBlock Text="Analiza bezpieczeństwa" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock Text="Analiza odbywa się lokalnie na podstawie reguł. Wynik nie jest gwarancją bezpieczeństwa." Style="{StaticResource MutedText}" Margin="4,0,4,12"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Sprawdź aktywne okno" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="Przycisk daje 3 sekundy na przełączenie okna. Czytamy dostępne statyczne etykiety UI Automation; pomijamy pola edycyjne i hasła." Style="{StaticResource MutedText}"/>
      <Button Content="Analizuj aktywne okno za 3 sekundy" Command="{Binding Capture}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10"/>
      <TextBlock Text="Analiza ręczna" Style="{StaticResource SectionTitle}" Margin="4,12,4,4"/>
      <TextBlock Text="Nie wklejaj haseł ani tokenów. Treść jest czyszczona z formularza i nie trafia do historii." Style="{StaticResource MutedText}"/>
      <TextBox Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" MaxLength="16000" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="Rzeczywisty adres docelowy (opcjonalny)" Style="{StaticResource MutedText}"/>
      <TextBox Text="{Binding ManualUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" IsUndoEnabled="False"/>
      <TextBlock Text="Widoczny tekst linku (opcjonalny)" Style="{StaticResource MutedText}"/>
      <TextBox Text="{Binding DisplayedUrl, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" IsUndoEnabled="False"/>
      <Button Content="Analizuj podane dane" Command="{Binding AnalyzeManual}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      <Border Background="{DynamicResource ControlSurface}" CornerRadius="12" Padding="12" Margin="4,10" AutomationProperties.LiveSetting="Assertive"><TextBlock Text="{Binding Message}" FontWeight="SemiBold"/></Border>
      <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{DynamicResource ControlSurface}" Padding="12" MinHeight="150"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Historia">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Historia lokalna" Style="{StaticResource SectionTitle}"/><TextBlock Text="Do 500 ostatnich zdarzeń na tym urządzeniu" Style="{StaticResource MutedText}"/></StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8"><DataGrid.Columns>
      <DataGridTextColumn Header="Czas" Binding="{Binding Timestamp, StringFormat={}{0:g}}"/><DataGridTextColumn Header="Ryzyko" Binding="{Binding Risk, Converter={StaticResource EnumLabel}}"/><DataGridTextColumn Header="Kategoria" Binding="{Binding Category, Converter={StaticResource EnumLabel}}"/><DataGridTextColumn Header="Aplikacja" Binding="{Binding Application}"/>
      <DataGridTextColumn Header="Sygnały i ograniczenia" Binding="{Binding Explanation}" Width="*"/><DataGridTextColumn Header="Zalecenie" Binding="{Binding Recommendation}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource EnumLabel}}"/>
     </DataGrid.Columns></DataGrid>
     <WrapPanel Grid.Row="2"><Button Content="Odśwież" Command="{Binding Refresh}"/><Button Content="Test powiadomienia" Command="{Binding TestNotification}"/><Button Content="Fałszywy alarm" Command="{Binding FalsePositive}"/><Button Content="Eksport" Command="{Binding Export}"/><Button Content="Usuń historię…" Command="{Binding Clear}"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Ustawienia">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
     <TextBlock Text="Ustawienia" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Kontroluj lokalną analizę i prywatność urządzenia." Style="{StaticResource MutedText}" Margin="4,0,4,12"/>
     <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Ogólne" Style="{StaticResource SectionTitle}"/><TextBlock Text="Motyw aplikacji" Style="{StaticResource MutedText}"/><ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="Systemowy" Tag="System"/><ComboBoxItem Content="Jasny" Tag="Light"/><ComboBoxItem Content="Ciemny" Tag="Dark"/></ComboBox><CheckBox Content="Uruchamiaj okno w zasobniku" IsChecked="{Binding StartMinimized}" Margin="4,8"/><TextBlock Text="Zamknięcie okna ukrywa je w zasobniku; zakończenie aplikacji wybierz z menu ikony." Style="{StaticResource MutedText}"/>
      <TextBlock Text="Ochrona lokalna" Style="{StaticResource SectionTitle}" Margin="4,16,4,4"/><CheckBox Content="Analizuj przy zmianie aktywnego okna" IsChecked="{Binding Monitoring.MonitorForegroundChanges}" Margin="4,6"/><TextBlock Text="Odstęp między odczytami (3–300 sekund)" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Monitoring.MinimumIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left"/><CheckBox Content="Czytaj dostępne statyczne etykiety UI Automation" IsChecked="{Binding Monitoring.CollectStaticText}" Margin="4,6"/><CheckBox Content="Wyklucz znane przeglądarki" IsChecked="{Binding Monitoring.ExcludeBrowsers}" Margin="4,6"/><CheckBox Content="Wyklucz znane komunikatory i klientów poczty" IsChecked="{Binding Monitoring.ExcludeMessaging}" Margin="4,6"/>
      <TextBlock Text="Wykluczone procesy (oddziel średnikami)" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Monitoring.ExcludedApplications, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"/><TextBlock Text="Wykluczone fragmenty tytułów okien" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Monitoring.ExcludedWindowTitles, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"/>
      <TextBlock Text="Prywatność i historia" Style="{StaticResource SectionTitle}" Margin="4,16,4,4"/><TextBlock Text="Dane pozostają lokalnie. Analiza nie wysyła treści do serwera." Style="{StaticResource MutedText}"/><TextBlock Text="Katalog danych" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/><WrapPanel><TextBlock Text="Retencja dni" VerticalAlignment="Center"/><TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="70"/><CheckBox Content="Powiadomienia w aplikacji" IsChecked="{Binding Notifications}" Margin="12,4"/><Button Content="Kopia bazy" Command="{Binding Backup}"/></WrapPanel>
      <TextBlock Text="Diagnostyka i informacje" Style="{StaticResource SectionTitle}" Margin="4,16,4,4"/><TextBlock Text="Analiza lokalna: dostępna · UI Automation: Windows · Synchronizacja serwera: nie skonfigurowano" Style="{StaticResource MutedText}"/>
      <Button Content="Zapisz ustawienia" Command="{Binding Save}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="4,10,4,0"><TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
